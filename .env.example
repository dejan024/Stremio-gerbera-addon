# Base URL of the Gerbera server (the UPnP port, same one as the web UI).
# Verify with: curl http://<host>:<port>/description.xml
GERBERA_URL=http://192.168.1.10:49494

# Port the addon listens on, behind the TLS proxy.
PORT=7100

# Port Caddy serves HTTPS on. This is the port you give to Stremio.
HTTPS_PORT=7443

# How often the Gerbera library is rescanned, in minutes.
REFRESH_MINUTES=30

# Resolve local titles to IMDb ids through Cinemeta, so local files show up
# as a source in regular Stremio search. Set to false for an offline install;
# the catalogs keep working either way.
MATCH_IMDB=true

# A library scan still running after this many minutes counts as hung, and
# /health starts answering 503 so the container gets restarted.
SCAN_TIMEOUT_MINUTES=10


# ---------------------------------------------------------------------------
# Metadata
# ---------------------------------------------------------------------------

# Look up posters, descriptions, genres, ratings and episode names for the
# files on the server. Set to false to go back to plain filenames; nothing
# else about the addon changes.
META_ENRICH=true

# Optional. Without it the addon uses Cinemeta only, which needs no key and
# covers anything with an IMDb id. A TMDB key adds a second provider for what
# Cinemeta does not have — regional and older titles, and films whose local
# name differs from the official one.
# Free key: https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Language for TMDB descriptions, as a TMDB locale code (en, sr-RS, de-DE...).
# Cinemeta has no language parameter and always answers in English, so with a
# non-English setting you get a mix: English for titles Cinemeta recognised,
# the chosen language only for those that fell through to TMDB.
META_LANG=en

# How long a metadata record is kept before it is looked up again, and how
# long a title no provider recognised is remembered as a miss. The short miss
# lifetime is deliberate: metadata databases keep growing, so a title nobody
# knew last week is worth retrying.
META_TTL_DAYS=30
META_MISS_TTL_DAYS=3

# How long a resolved IMDb id is kept. Longer than the metadata itself,
# because a title's id never changes once it is known.
IMDB_TTL_DAYS=180

# Concurrent provider lookups during the background metadata pass.
LOOKUP_CONCURRENCY=4
